#!name=隐私净化与防盗链重写
#!desc=剥离常见网页追踪参数，并统一接管 Google/IGN 重定向与图床防盗链 Header 重写
#!category=隐私净化

[URL Rewrite]
^https?:\/\/(www\.)?g\.cn https://www.google.com 302
^https?:\/\/(www\.)?google\.cn https://www.google.com 302
^https?:\/\/(www\.)?ign\.xn--fiqs8s\/ http://cn.ign.com/ccpref/us 302

[Header Rewrite]
http-request ^https?:\/\/[^/]+\.bdimg\.com\/ header-del Referer
http-request ^https?:\/\/[^/]+\.qpic\.cn\/ header-del Referer
http-request ^https?:\/\/[^/]+\.ph\.126\.net\/ header-del Referer
http-request ^https?:\/\/[^/]+\.zhimg\.com\/ header-del Referer

[Script]
url_cleaner.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/scripts/url_cleaner.js,type=http-request,pattern=^https?:\/\/(www\.zhihu\.com|zhuanlan\.zhihu\.com|www\.bilibili\.com|m\.bilibili\.com)\/.*\?

[MITM]
hostname = %APPEND% g.cn, www.g.cn, google.cn, www.google.cn, *.bdimg.com, *.qpic.cn, *.ph.126.net, *.zhimg.com, www.zhihu.com, zhuanlan.zhihu.com, www.bilibili.com, m.bilibili.com
