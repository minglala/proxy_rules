#!name=节点运维监控与自愈套装
#!desc=集成节点状态概览面板、一键调通自愈按钮及网络切换自动清缓存脚本
#!category=运维监控

[Panel]
Node_Overview=title="节点状态概览",content="正在统计节点状态...",style=info,script-name=node_overview.js,update-interval=600
One_Click_Fix=title="一键调通与自愈",content="轻点此卡片执行一键调通",style=info,script-name=one_click_fix.js,update-interval=86400

[Script]
auto_flush_dns.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/scripts/flush_dns.js,type=event,event-name=network-changed
node_overview.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/scripts/node_overview.js,type=generic,timeout=20
one_click_fix.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/scripts/one_click_fix.js,type=generic,timeout=25
