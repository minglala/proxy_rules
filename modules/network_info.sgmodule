#!name=增强网络信息面板
#!desc=展示内网与IPv6状态、国内直连与代理双出口IP、落地属性、当前策略链路及双通道延迟
#!category=运维监控

[Panel]
Network_Info=title="网络信息",content="正在获取当前网络状态...",style=info,script-name=network_info.js,update-interval=300

[Script]
network_info.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/network_info.js,type=generic,timeout=15
