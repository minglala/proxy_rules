#!name=AI 与流媒体落地纯净度体检
#!desc=按需检测 AI 与主代理出口的 IP 类型、风控风险，以及 ChatGPT、Gemini、Claude、Netflix、YouTube 解锁状态
#!category=运维监控

[Panel]
Purity_Check=title="AI 与流媒体纯净度体检",content="轻点右上角刷新执行深度体检",style=info,script-name=purity_check.js,update-interval=86400

[Script]
purity_check.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/scripts/purity_check.js,type=generic,timeout=20
