#!name=节点域名枚举器
#!desc=点一下: 自动枚举节点服务器域名, 生成专用DoH指派并自动写入配置[Host]段生效(内部接口失败自动改走外部HTTP API); 不拉订阅
#!category=运维监控
#!arguments=doh1:https://alicdn-tbcdn-jdcdn-iycdn.mcw.gay/b13dc6533ab6db6cac6982acccec36e8/dns-query,doh2:https://txcdn-tbcdn-bdcdn-ykcdn.mcw.gay/292f105ae785d1845a8799971ac3a14b/dns-query,boot1:223.5.5.5,boot2:119.29.29.29
#!arguments-desc=doh1/doh2: 节点域名专用DoH地址(请勿留空); boot1/boot2: DoH自身域名的bootstrap解析(防循环依赖)

[Panel]
DNS_Enum=title="节点域名枚举",content="点击刷新开始枚举并自动应用",style=info,script-name=dns_enum8.js

[Script]
dns_enum8.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/dns_enum8.js,type=generic,timeout=300,argument="doh1={{{doh1}}}&doh2={{{doh2}}}&boot1={{{boot1}}}&boot2={{{boot2}}}"
