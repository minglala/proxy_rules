#!name=节点域名专用解析
#!desc=一个模块搞定: [Host]段由Surge自动合并进配置(本地[Host]为空也生效), 节点域名走专用DoH; 面板可重新枚举节点域名清单
#!category=网络优化
#!arguments=doh1:https://alicdn-tbcdn-jdcdn-iycdn.mcw.gay/b13dc6533ab6db6cac6982acccec36e8/dns-query,doh2:https://txcdn-tbcdn-bdcdn-ykcdn.mcw.gay/292f105ae785d1845a8799971ac3a14b/dns-query,boot1:223.5.5.5,boot2:119.29.29.29
#!arguments-desc=doh1/doh2: 节点域名专用DoH地址(机场令牌变更时改这里, 请勿留空); boot1/boot2: DoH自身域名的bootstrap解析(防循环依赖)

[Host]
*.mcw.gay = server:{{{boot1}}},{{{boot2}}}
*.inba996.com = server:{{{doh1}}},{{{doh2}}}
*.myinba55.com = server:{{{doh1}}},{{{doh2}}}
*.keyapisub.xyz = server:{{{doh1}}},{{{doh2}}}
*.chhbuv.cn = server:{{{doh1}}},{{{doh2}}}

[Panel]
DNS_Enum=title="节点域名枚举",content="点击刷新开始枚举",style=info,script-name=dns_enum9.js

[Script]
dns_enum9.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/dns_enum9.js,type=generic,timeout=300,argument="doh1={{{doh1}}}&doh2={{{doh2}}}&boot1={{{boot1}}}&boot2={{{boot2}}}"
