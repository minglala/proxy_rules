#!name=节点域名枚举器
#!desc=点一下: 自动枚举节点服务器域名, 生成专用DoH指派并自动写入配置[Host]段生效; 不拉订阅
#!category=运维监控
#!arguments=doh1:https://radar.l9oauy.com:34683/dns-query/1dbbdec9-5627-41a2-bfb8-b195af6544c6, doh2:https://8.163.85.149:44443/dns-query/1dbbdec9-5627-41a2-bfb8-b195af6544c6, doh3:https://23.146.72.61:44443/dns-query/1dbbdec9-5627-41a2-bfb8-b195af6544c6
#!arguments-desc=doh1/doh2/doh3: 节点域名专用DNS解析服务器(DoH完整地址), 在模块设置里修改, 留空表示不用该槽位

[Panel]
DNS_Enum=title="节点域名枚举",content="正在读取DNS缓存...",style=info,script-name=dns_enum5.js,update-interval=3600

[Script]
dns_enum5.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/dns_enum5.js,type=generic,timeout=600,argument=doh1={{{doh1}}}&doh2={{{doh2}}}&doh3={{{doh3}}}
