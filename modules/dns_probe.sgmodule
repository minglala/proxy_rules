#!name=节点DNS探针
#!desc=只读探测: 验证策略详情接口与DNS缓存能否自动枚举节点服务器域名, 不改配置不拉订阅
#!category=运维监控

[Panel]
DNS_Probe=title="节点DNS探针",content="正在探测枚举通道...",style=info,script-name=dns_probe.js,update-interval=3600

[Script]
dns_probe.js=script-path=https://raw.githubusercontent.com/minglala/proxy_rules/refs/heads/main/dns_probe.js,type=generic,timeout=30
